DJANGO_SECRET_KEY=your-production-key-here
DEBUG=False
ALLOWED_HOSTS=your-app-name.railway.app,localhost
DATABASE_URL=postgres://user:password@host:port/dbname
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Observability — leave blank to disable Sentry locally
SENTRY_DSN=

# S3 media storage — leave blank to use local filesystem (files lost on redeploy)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
